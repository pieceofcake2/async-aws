{
    "name": "pieceofcake2/async-aws",
    "description": "AsyncAws integration for CakePHP 2: DynamoDB session handler and cache, Amazon SES email transport, S3 helper",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "aws", "async-aws", "s3", "dynamodb", "ses"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "async-aws/core": "^1.27",
        "async-aws/dynamo-db": "^3.8",
        "async-aws/ses": "^1.13",
        "async-aws/simple-s3": "^2.1 || ^3.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpstan-cakephp2": "^0.2.3"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "AsyncAws"
    }
}
